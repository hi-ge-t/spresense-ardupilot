    "pinshare": "eMMC",
    "hal_integration": "AP_InertialSensor_Spresense",
    "orientation": "ROTATION_NONE-hardware-HOLD",
    "runtime_fallback": "disabled"
  },
  "safety": {
    "arming": "copter-path-always-reject",
    "actuator_driver": "reject-only-no-physical-backend",
